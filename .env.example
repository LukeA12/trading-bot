# Trading Bot Configuration
# Copy this to .env and fill in values

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./tradingbot.db
# DATABASE_URL=postgresql://user:pass@localhost/tradingbot

# Simulation settings
SIMULATION_MODE=true
INITIAL_BANKROLL=10000
KELLY_FRACTION=0.25
MIN_EDGE_THRESHOLD=0.08

# AWS Secrets Manager
# These allow the app to fetch API keys (GROQ, Kalshi, Polymarket, Anthropic) from Secrets Manager
AWS_ACCESS_KEY_ID=your_iam_user_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_user_secret_access_key
AWS_REGION=us-east-1
AWS_SECRET_NAME=trading-bot/api-keys

# Kalshi API (non-secret config only — actual keys live in Secrets Manager)
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENABLED=true
POLYMARKET_ENABLED=true
FRED_API_KEY=
BLS_API_KEY=

# Mapbox token for map visualization (optional - demo token works)
VITE_MAPBOX_TOKEN=
